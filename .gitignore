tools/regen/.module-cache/
# CI regen Gradle/Minecraft download cache (mounted into the container):
gradle-cache/
# Headless JDK+MC harness (large; provided separately):
tools/script-runner/
# Downloaded Kotlin compiler toolchain (kdoc-extractor):
**/kotlinc/
# Python venvs / caches:
**/.venv*/
**/__pycache__/
